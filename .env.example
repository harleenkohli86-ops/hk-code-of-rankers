# =====================================================================
#  HK Code of Rankers — environment variables
#  Copy this file, save it as `.env`, and fill in the values.
#  (If you are using a hosting panel, add the same values under "Environment variables".)
#  NOTE: If a value contains #, put the value in "double quotes".
# =====================================================================

# ---------- 1. DATABASE (required) ----------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (URI)
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local PostgreSQL:  postgres://user:password@localhost:5432/hkrankers
DATABASE_URL=

# Tables are created automatically (db/schema.sql). Set this to false to disable it.
AUTO_MIGRATE=true

# ---------- 2. SECURITY (required) ----------
# Long random string (32+ characters). To generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---------- 3. ADMIN (pehli baar) ----------
# When the server starts, this admin is created if no admin exists.
ADMIN_NAME=Harkiran Kaur
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# ---------- 4. WEBSITE ----------
# For links in emails (without a trailing /)
APP_URL=https://yourdomain.com
PORT=3000

# ---------- 5. EMAIL (optional — everything works without it, but emails are not sent) ----------
# Email address where admin notifications should be sent
ADMIN_NOTIFICATION_EMAIL=

# Option A: Brevo (https://brevo.com) — PRIMARY, Render pe chalta hai
BREVO_API_KEY=
BREVO_FROM_EMAIL=HK Code of Rankers <you@gmail.com>

# Option B: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=HK Code of Rankers <noreply@yourdomain.com>

# Option C: SMTP (such as a Hostinger email account)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
