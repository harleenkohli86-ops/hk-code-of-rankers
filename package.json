{
  "name": "hk-code-of-rankers",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "db:setup": "node scripts/db-setup.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "tailwindcss": "^4.1.14",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "description": "HK Code of Rankers — CS mentorship platform (React + Express + PostgreSQL)",
  "engines": {
    "node": ">=18"
  }
}
